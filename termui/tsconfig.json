{
  "compilerOptions": {
"target": "es6",
    "lib": ["esnext"],
    "inlineSources": true,
    "inlineSourceMap": true,
    "strict": true,
    "module": "commonjs",
    "outDir": "build",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src"
  ], 
  "exclude": [
    "node_modules",
    "build"
  ]
}
